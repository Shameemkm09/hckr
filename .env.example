# HCKR Dashboard - Environment Configuration
# Copy this file to .env and modify values as needed

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Configuration
SESSION_SECRET=hckr_secure_secret_key_2024
SESSION_TIMEOUT=86400000

# Logging
LOG_LEVEL=info

# Features
ENABLE_CORS=false
ENABLE_RATE_LIMITING=false
MAX_REQUEST_SIZE=50mb

# Security
SECURE_COOKIES=true
SAME_SITE_COOKIES=Strict

# Audio Files
AUDIO_DIR=./audio
MAX_AUDIO_SIZE=52428800

# Database (for future use)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hckr
# DB_USER=admin
# DB_PASSWORD=secure_password
